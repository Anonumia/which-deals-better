---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import { siteConfig } from '../config/site';
const title = "Unit Price Calculator – Compare Prices & Find the Better Deal | Which Deal's Better?";
const description = 'Compare unit prices, product quantities, multipacks, ounces, pounds, liters, counts, and more to quickly find the lowest unit cost.';
const faqs = [
  ['What is unit price?', 'Unit price is the cost of one standard unit—such as one ounce, item, or milliliter. It makes differently sized packages easier to compare.'],
  ['How do I compare products with different quantities?', 'Enter the price, Amount in Unit, and unit for each option. For a multipack, turn on “This is a multipack,” then enter the number of items in the pack. Amount in Unit is what one item contains.'],
  ['Can I compare ounces and pounds?', 'Yes. Ounces and pounds are converted to a shared unit automatically.'],
  ['Can I compare grams and kilograms?', 'Yes. Kilograms are converted to grams before the prices are compared.'],
  ['Can I compare liters and milliliters?', 'Yes. Liters, milliliters, and U.S. liquid-volume units can be compared automatically.'],
  ['Can I compare multipacks?', 'Yes. Turn on “This is a multipack,” then enter the number of items in the pack. Amount in Unit describes what each item contains, and the calculator multiplies them automatically.'],
  ['Can I compare more than two products?', 'Yes. Add up to five deals and the calculator will rank their unit prices.'],
  ['Does a larger package always cost less?', 'No. Promotions, brand pricing, and package design can make a smaller option cheaper per unit.'],
  ['Does the calculator save my shopping information?', 'Compare Deals does not persist entries unless you choose Track this purchase. That optional handoff stays in your browser, and Usage Tracker records are stored locally on this device. No account is required.'],
];
const schema = [
  { '@context':'https://schema.org', '@type':'WebSite', name:siteConfig.name, url:siteConfig.url },
  { '@context':'https://schema.org', '@type':'WebApplication', name:siteConfig.name, url:siteConfig.url, applicationCategory:'UtilitiesApplication', operatingSystem:'Any', offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}, description },
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) },
];
---
<BaseLayout {title} {description} {schema} allowAds>
  <section class="hero"><div class="shell hero-inner"><p class="eyebrow">Shop with the math done</p><h1>Which Deal's Better?</h1><p class="tagline"><span>Compare prices and sizes.</span> <span>Find the better deal in seconds.</span></p></div></section>
  <div class="shell calculator-wrap"><Calculator /></div>
  <section class="content-section alt"><div class="shell"><div class="prose"><p class="eyebrow">One connected shopping toolkit</p><h2>Compare the deal, then check the promotion</h2><p>Unit price strips away package-size confusion. The other tools show what BOGO language and coupons do to the real checkout total and effective price, while the private tracker records how quickly your household uses an item.</p><p class="formula">Price ÷ total quantity = unit price</p><p>See the <a href="/methodology/">calculation methodology</a>, including conversions, promotion groups, discounts, and usage averages.</p></div><div class="tool-grid"><article class="info-card"><p class="eyebrow">Compare</p><h3><a href="/">Compare prices</a></h3><p>Normalize package sizes, multipacks, and compatible units to find the lowest unit cost.</p></article><article class="info-card"><p class="eyebrow">Promotions</p><h3><a href="/bogo-calculator/">Calculate BOGO deals</a></h3><p>Price complete Buy X Get Y groups and compare checkout cost with effective price per item.</p></article><article class="info-card"><p class="eyebrow">Coupons</p><h3><a href="/coupon-comparator/">Understand coupons</a></h3><p>Compare sale prices, percentage-off, and dollar-off offers by final cost.</p></article><article class="info-card"><p class="eyebrow">Usage</p><h3><a href="/usage-tracker/">Track actual usage</a></h3><p>Keep private, browser-local records of how long household supplies last.</p></article></div></div></section>
  <section class="content-section"><div class="shell prose"><p class="eyebrow">Real shopping situations</p><h2>Comparing sale bundles</h2><p>For “2 for $10,” enter $10 as the price, turn on the multipack option, and enter 2 as the number of items in the pack. Do the same for “3 for $14.” Amount in Unit describes what one item contains.</p><h2>Compare like with like</h2><p>The calculator converts compatible units and warns when they describe different things. Weight cannot be fairly compared with volume. Count labels also need judgment: a roll and a sheet are both counts, but are not equivalent amounts.</p><p>Explore <a href="/shopping-examples/">worked shopping examples</a>, the <a href="/guides/multipacks-bogo-multibuy/">multipack and multi-buy guide</a>, and the guide to <a href="/guides/when-lowest-unit-price-isnt-enough/">limits of lowest unit price</a>.</p></div></section>
  <section class="content-section alt faq"><div class="shell prose"><p class="eyebrow">Questions, answered</p><h2>Frequently asked questions</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
</BaseLayout>
<style>
  @media(max-width:470px){
    .tagline span{display:block;white-space:nowrap}
  }
</style>
