---
import { siteConfig } from '../config/site';
import { moreNavigation, primaryNavigation } from '../config/navigation';
---
<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}><img class="brand-mark" src="/favicon.svg" width="28" height="28" alt="" /> <span>{siteConfig.name}</span></a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <div class="nav-more" data-nav-more>
        <button class="more-toggle" type="button" aria-expanded="false" aria-controls="more-menu" data-more-toggle>More <span aria-hidden="true">▾</span></button>
        <div class="more-menu" id="more-menu" data-more-menu hidden>
          {moreNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header{position:relative;z-index:60}
  .brand{display:inline-flex;min-width:0;align-items:center;gap:.5rem;line-height:1.1;white-space:nowrap}
  .brand span{color:inherit}
  .brand-mark{display:block;width:1.65rem;height:1.65rem;flex:0 0 auto}
  .primary-nav{display:flex;align-items:center;gap:clamp(.75rem,2.4vw,1.5rem)}
  .primary-nav>a,.more-toggle{display:flex;min-height:44px;align-items:center;white-space:nowrap}
  .nav-more{position:relative;display:flex;align-items:center}
  .more-toggle{border:1px solid transparent;background:transparent;padding:.4rem 0;font-size:.94rem;font-weight:650;cursor:pointer}
  .more-toggle span{font-size:.72em}
  .more-menu{position:absolute;z-index:70;top:calc(100% + .2rem);right:0;display:grid;width:max-content;min-width:12rem;max-width:calc(100vw - 20px);padding:.65rem;border:1px solid var(--line);border-radius:10px;background:var(--card);box-shadow:var(--shadow)}
  .more-menu[hidden]{display:none}
  .more-menu a{display:flex;min-height:44px;align-items:center;padding:.55rem .65rem;border-radius:7px}

  @media(max-width:679px){
    .header-inner{min-height:0;flex-direction:column;align-items:stretch;gap:0;padding:.45rem 0 .25rem}
    .brand{align-self:flex-start;min-height:44px;font-size:clamp(.9rem,4vw,1rem)}
    .primary-nav{width:100%;justify-content:space-between;gap:clamp(.2rem,2vw,.55rem)}
    .primary-nav>a,.more-toggle{padding-inline:.05rem;font-size:clamp(.78rem,3.6vw,.94rem)}
    .more-menu{min-width:12rem}
    .more-menu a{min-height:48px;padding:.65rem .75rem;font-size:.94rem}
  }
</style>

<script>
  const header = document.querySelector('[data-site-header]');
  if (header instanceof HTMLElement) {
    const more = header.querySelector('[data-nav-more]');
    const moreToggle = header.querySelector('[data-more-toggle]');
    const moreMenu = header.querySelector('[data-more-menu]');
    const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
    const setMoreOpen = (open: boolean) => {
      if (!(moreToggle instanceof HTMLButtonElement) || !(moreMenu instanceof HTMLElement)) return;
      moreToggle.setAttribute('aria-expanded', String(open));
      moreMenu.hidden = !open;
    };

    moreToggle?.addEventListener('click', () => setMoreOpen(moreToggle.getAttribute('aria-expanded') !== 'true'));
    more?.addEventListener('pointerenter', () => { if (hoverQuery.matches) setMoreOpen(true); });
    more?.addEventListener('pointerleave', () => { if (hoverQuery.matches && !more.matches(':focus-within')) setMoreOpen(false); });
    more?.addEventListener('focusout', (event) => { const target = event instanceof FocusEvent ? event.relatedTarget : null; const next = target instanceof Node ? target : null; if (!more.contains(next)) setMoreOpen(false); });
    moreMenu?.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('a')) setMoreOpen(false); });
    document.addEventListener('click', (event) => { if (event.target instanceof Node && !header.contains(event.target)) setMoreOpen(false); });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const wasOpen = moreToggle instanceof HTMLButtonElement && moreToggle.getAttribute('aria-expanded') === 'true';
      setMoreOpen(false);
      if (wasOpen && moreToggle instanceof HTMLButtonElement) moreToggle.focus();
    });
    header.dataset.navigationReady = 'true';
  }
</script>
