---
import { unitGroups } from '../lib/units';
---
<section class="calculator-panel tool-panel" data-stockup aria-labelledby="stockup-title">
  <div class="calculator-heading"><div><p class="eyebrow">Stock-up sale calculator</p><h2 id="stockup-title">Estimate whether extra quantity fits your usage</h2></div><button class="text-button" type="button" data-reset>Reset</button></div>
  <p class="helper">This calculation compares today’s sale with the normal price and estimates how long the quantity may last. It does not predict future prices.</p>
  <form class="tool-form" data-form>
    <label class="full-field">Item name <span>(optional, used to find matching history)</span><input data-field="name" maxlength="80" placeholder="Paper towels" autocomplete="off" /></label>
    <div class="field-row"><label>Sale price per package<span class="input-prefix"><span aria-hidden="true">$</span><input data-field="salePrice" type="number" min="0.01" step="0.01" inputmode="decimal" /></span></label><label>Normal price per package<span class="input-prefix"><span aria-hidden="true">$</span><input data-field="normalPrice" type="number" min="0.01" step="0.01" inputmode="decimal" /></span></label></div>
    <div class="field-row"><label>Amount in Unit per package<input data-field="amountPerPackage" type="number" min="0.01" step="any" inputmode="decimal" aria-describedby="amount-help" /></label><label>Unit<select data-field="unit">{unitGroups.map(({ group, units }) => <optgroup label={group}>{units.map((unit) => <option value={unit.value}>{unit.label}</option>)}</optgroup>)}</select></label></div>
    <p class="field-help" id="amount-help">Examples: 12 rolls, 24 count, or 1.5 lb in each package.</p>
    <div class="field-row"><label>Packages to buy<input data-field="packageCount" type="number" min="1" step="1" inputmode="numeric" value="1" /></label><label>Expected use per day<input data-field="amountPerDay" type="number" step="1" inputmode="decimal" aria-describedby="usage-source" /></label></div>
    <div class="history-picker" data-history-wrap hidden><label>Use tracked history<select data-history><option value="">Choose an item history</option></select></label></div>
    <p id="usage-source" class="field-help" data-source>No completed tracker history found. Enter your own daily usage estimate.</p>
  </form>
  <div class="results" data-results aria-live="polite" aria-atomic="true"><p class="results-empty">Enter prices, package amount, quantity, and a usage rate to estimate the stock-up value.</p></div>
</section>
<script>
  import { calculateStockUp, presentStockUp } from '../lib/stockup';
  import { parseUsageRecords, summarizeUsage, usageKey, USAGE_STORAGE_KEY } from '../lib/usage';
  import { unitMap } from '../lib/units';
  const root = document.querySelector('[data-stockup]');
  const number = (value: number, digits = 1) => new Intl.NumberFormat('en-US', { maximumFractionDigits:digits }).format(value);
  if (root instanceof HTMLElement) {
    const resultEl = root.querySelector('[data-results]'); const historySelect = root.querySelector('[data-history]'); const source = root.querySelector('[data-source]');
    const records = parseUsageRecords(localStorage.getItem(USAGE_STORAGE_KEY));
    const groups = new Map<string, { name:string; unit:string }>(); records.filter((record) => record.completedDate).forEach((record) => groups.set(usageKey(record.name, record.unit), { name:record.name, unit:record.unit }));
    if (historySelect instanceof HTMLSelectElement && groups.size) {
      const wrap = root.querySelector('[data-history-wrap]'); if (wrap instanceof HTMLElement) wrap.hidden = false;
      if (source) source.textContent = 'Choose a completed history to fill the usage rate, or enter your own estimate.';
      groups.forEach((group, key) => { const summary = summarizeUsage(records, group.name, group.unit); if (!summary) return; const option = document.createElement('option'); option.value = key; option.textContent = `${group.name} · ${number(summary.amountPerWeek, 2)} ${unitMap.get(group.unit)?.label ?? group.unit}/week (${summary.records} period${summary.records === 1 ? '' : 's'})`; option.dataset.rate = String(summary.amountPerDay); option.dataset.name = group.name; option.dataset.unit = group.unit; option.dataset.records = String(summary.records); historySelect.append(option); });
    }
    const field = (name: string) => root.querySelector(`[data-field="${name}"]`) as HTMLInputElement | HTMLSelectElement | null;
    const update = () => {
      const values = Object.fromEntries([...root.querySelectorAll('[data-field]')].map((item) => [item.getAttribute('data-field'), item instanceof HTMLInputElement || item instanceof HTMLSelectElement ? item.value : '']));
      if (!(resultEl instanceof HTMLElement)) return;
      if (!values.salePrice && !values.normalPrice && !values.amountPerPackage && !values.amountPerDay) { resultEl.innerHTML = '<p class="results-empty">Enter prices, package amount, quantity, and a usage rate to estimate the stock-up value.</p>'; return; }
      const result = calculateStockUp(values as any);
      if (!result) { resultEl.innerHTML = '<p class="results-alert"><strong>Check the details.</strong> Use positive prices and amounts, plus a whole number of packages.</p>'; return; }
      const unit = unitMap.get(String(values.unit))?.label ?? String(values.unit);
      const presentation = presentStockUp(result, Number(values.packageCount), unit);
      const metrics = presentation.metrics.map((metric) => `<li><span>${metric.label}</span><strong>${metric.value}</strong></li>`).join('');
      resultEl.innerHTML = `<p class="eyebrow">Stock-up estimate</p><h3>${presentation.headline}</h3><p>${presentation.summary}</p><ul class="metric-grid">${metrics}</ul><p class="result-note">Use this alongside storage space, shelf life, cash available today, and how interchangeable the product is for your household.</p>`;
    };
    historySelect?.addEventListener('change', () => { if (!(historySelect instanceof HTMLSelectElement)) return; const option = historySelect.selectedOptions[0]; if (!option?.dataset.rate) return; const rate = field('amountPerDay'); const name = field('name'); const unit = field('unit'); if (rate) rate.value = option.dataset.rate; if (name) name.value = option.dataset.name ?? ''; if (unit) unit.value = option.dataset.unit ?? 'item'; if (source) source.textContent = `Using the weighted average from ${option.dataset.records} completed tracker period${option.dataset.records === '1' ? '' : 's'}. You can override the daily rate.`; update(); });
    root.addEventListener('input', update); root.addEventListener('change', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => { root.querySelectorAll('input').forEach((input) => input.value = input.dataset.field === 'packageCount' ? '1' : ''); if (historySelect instanceof HTMLSelectElement) historySelect.value = ''; if (source) source.textContent = 'Choose a completed history to fill the usage rate, or enter your own estimate.'; update(); });
  }
</script>
