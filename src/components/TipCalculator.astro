<section class="calculator-panel tool-panel tip-panel" data-tip-calculator aria-labelledby="tip-title">
  <div class="calculator-heading"><div><p class="eyebrow">Tip calculator</p><h2 id="tip-title">Tip options</h2></div><button class="text-button" type="button" data-reset>Reset</button></div>
  <p class="helper">Enter your bill to see 15%, 18%, and 20% tip totals.</p>
  <label class="full-field tip-bill">Bill amount<span class="input-prefix"><span aria-hidden="true">$</span><input data-bill type="number" min="0.01" step="0.01" inputmode="decimal" autocomplete="off" /></span></label>
  <div class="results" data-results aria-live="polite" aria-atomic="true"><p class="results-empty">Enter a bill amount to see all three tip options.</p></div>
</section>

<style>
  .tip-panel{max-width:680px;margin-inline:auto}
  .tip-bill{max-width:22rem}
  :global(.tip-bill-summary){margin:.1rem 0 .8rem;color:var(--ink-soft)}
  :global(.tip-result-grid){display:grid;gap:.7rem}
  :global(.tip-result-card){padding:.85rem;border:1px solid rgba(24,57,47,.14);border-radius:12px;background:rgba(255,255,255,.55)}
  :global(.tip-result-card h3){margin:0 0 .45rem;font-size:1.35rem}
  :global(.tip-result-card dl){display:grid;grid-template-columns:1fr auto;gap:.3rem .75rem;margin:0}
  :global(.tip-result-card dt){color:var(--ink-soft)}
  :global(.tip-result-card dd){margin:0;font-weight:850;text-align:right}
  @media(min-width:600px){
    :global(.tip-result-grid){grid-template-columns:repeat(3,minmax(0,1fr))}
    :global(.tip-result-card dl){grid-template-columns:1fr}
    :global(.tip-result-card dd){text-align:left;font-size:1.05rem}
  }
</style>

<script>
  import { calculateTipOptions } from '../lib/tip';

  const root = document.querySelector('[data-tip-calculator]');
  const money = (value: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(value);
  if (root instanceof HTMLElement) {
    const bill = root.querySelector('[data-bill]');
    const resultEl = root.querySelector('[data-results]');
    const update = () => {
      if (!(bill instanceof HTMLInputElement) || !(resultEl instanceof HTMLElement)) return;
      if (!bill.value) { resultEl.innerHTML = '<p class="results-empty">Enter a bill amount to see all three tip options.</p>'; return; }
      const results = calculateTipOptions(bill.value);
      if (!results) { resultEl.innerHTML = '<p class="results-alert"><strong>Check the bill amount.</strong> Use a value greater than zero.</p>'; return; }
      const cards = results.map((result) => `<article class="tip-result-card"><h3>${result.percentage}%</h3><dl><dt>Tip</dt><dd>${money(result.tip)}</dd><dt>Total</dt><dd>${money(result.total)}</dd></dl></article>`).join('');
      resultEl.innerHTML = `<p class="eyebrow">Tip options</p><p class="tip-bill-summary">Bill: <strong>${money(results[0].bill)}</strong></p><div class="tip-result-grid">${cards}</div>`;
    };
    bill?.addEventListener('input', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      if (bill instanceof HTMLInputElement) bill.value = '';
      update();
    });
  }
</script>
